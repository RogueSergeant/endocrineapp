# Cloudflare Workers static-asset headers.
# Cross-origin isolation (COOP + COEP) unlocks SharedArrayBuffer, which
# onnxruntime-web needs to run OCR on several threads. Everything the site
# loads is same-origin, so require-corp breaks nothing.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=()

# Hashed build output and versioned model files never change in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must be revalidated so updates roll out.
/sw.js
  Cache-Control: no-cache
